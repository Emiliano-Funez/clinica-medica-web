DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=base_de_datos_clinica
PORT=3000
JWT_SECRET=poné-un-texto-largo-y-secreto

# --- Sede y Google Maps ---
# Clave de Maps JavaScript API (Google Cloud Console). Restringila por dominio (HTTP referrers).
GOOGLE_MAPS_API_KEY=
SEDE_NOMBRE=ClinicaMed
SEDE_DIRECCION=Centro Universitario del Este (Segunda Etapa)
SEDE_LAT=-33.092303579457216
SEDE_LNG=-68.47412617772954
SEDE_MAP_ID=DEMO_MAP_ID
# Si frontend y backend están en dominios distintos, agregá aquí los orígenes permitidos.
FRONTEND_ORIGINS=

# --- Notificaciones: correo (Gmail API) ---
# Cuenta emisora y credenciales OAuth2. NO uses credenciales que hayan circulado: generá unas nuevas.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_USER=

# --- Notificaciones: SMS (SMS Masivos) ---
SMS_MASIVOS_API_KEY=
SMS_MASIVOS_URL=https://servicio.smsmasivos.com.ar/enviar_sms.asp
# 1 = modo prueba: valida el envío con TEST=1 y NO manda SMS reales. Poné 0 para enviar de verdad.
SMS_MASIVOS_TEST=1
# Franja horaria permitida para SMS (hora de Argentina)
SMS_HORA_DESDE=8
SMS_HORA_HASTA=22

# --- WhatsApp Cloud API (Meta): todavía no implementado, variables reservadas ---
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=

# --- Comportamiento general ---
# Canal por defecto: auto | email | sms  (auto = todos los que el paciente tenga disponibles)
NOTIF_CANAL_PREDETERMINADO=auto
# Canales que usa el modo automático
NOTIF_CANALES_AUTO=email,sms
# 0 = desactiva los recordatorios automáticos (24 h y 2 h antes)
NOTIF_RECORDATORIOS=1

